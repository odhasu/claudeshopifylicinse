{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    { "src": "site/**", "use": "@vercel/static" },
    { "src": "dashboard/**", "use": "@vercel/static" },
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**", "theme-dist/**"]
      }
    }
  ],
  "routes": [
    { "src": "/", "dest": "/site/theme.html", "status": 308 },
    { "src": "/api/(.*)", "dest": "/index.js" },
    { "src": "/dashboard", "dest": "/dashboard/index.html" },
    { "src": "/_next/(.*)", "dest": "/site/_next/$1" },
    { "src": "/((?:.*\\.(?:js|css|svg|ico|png|jpg|jpeg|webp|gif|woff2|woff|ttf|otf|eot|txt|json|xml|webmanifest|map)))", "dest": "/site/$1" },
    { "src": "/(.*)", "dest": "/site/$1.html" }
  ]
}
