{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "builds": [
    {
      "src": "site/**",
      "use": "@vercel/static"
    },
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**", "theme-dist/**"]
      }
    }
  ],
  "routes": [
    { "src": "/", "dest": "/site/theme.html", "status": 308 },
    { "src": "/api/(.*)", "dest": "/index.js" },
    { "src": "/(.*)", "dest": "/site/$1" }
  ]
}
