# Railway / Vercel Environment Variables
# Set these in your deployment dashboard → Variables

PORT=3000
# production | development
NODE_ENV=production
# Use a long random value (at least 32 chars)
ADMIN_KEY=your-secret-admin-key-here
DB_PATH=/app/data/licenses.db

# Optional: limit browser origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=https://your-frontend.example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Public app URL for checkout redirects and links
PUBLIC_BASE_URL=https://your-frontend.example.com
# Optional strict checkout origins (comma-separated)
CHECKOUT_ALLOWED_ORIGINS=https://your-frontend.example.com

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Upstash Redis (KV)
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
# Optional resilience tuning
KV_HTTP_TIMEOUT_MS=3000
KV_HTTP_RETRY_COUNT=1
# Optional in-memory cache TTL for KV reads (milliseconds)
KV_CACHE_TTL_MS=5000

# Frontend (set in Vercel for the Next.js app)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_API_URL=https://your-express-backend.railway.app
