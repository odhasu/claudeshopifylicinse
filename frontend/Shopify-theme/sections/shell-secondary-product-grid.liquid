<section id="scaled-secondary-product-grid" class="scaled-shell scaled-shell--loading" data-scaled-section="secondary-product-grid" aria-label="Products">
<div class="scaled-editor-preview">
<h2 class="scaled-editor-preview__headline">{{ section.settings.headline | default: "More Products You'll Love" }}</h2>
{%- if section.settings.subheadline != blank -%}<p class="scaled-editor-preview__subheadline">{{ section.settings.subheadline }}</p>{%- endif -%}
{%- assign has_products = false -%}{%- for block in section.blocks -%}{%- if block.type == 'product' and block.settings.product != blank -%}{%- assign has_products = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- if has_products -%}
<div class="scaled-editor-preview__grid" style="--products-per-row: {{ section.settings.products_per_row | default: 4 }}">{%- for block in section.blocks -%}{%- if block.type == 'product' and block.settings.product != blank -%}{%- assign product = block.settings.product -%}<div class="scaled-editor-preview__product" {{ block.shopify_attributes }}><div class="scaled-editor-preview__product-image">{%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{%- else -%}<div class="scaled-editor-preview__product-placeholder"><svg viewBox="0 0 24 24" fill="currentColor" width="48" height="48" opacity="0.3"><path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg></div>{%- endif -%}{%- if product.compare_at_price > product.price -%}<span class="scaled-editor-preview__badge">{{ section.settings.sale_badge_text | default: 'SALE' }}</span>{%- endif -%}</div><h3 class="scaled-editor-preview__product-title">{{ product.title }}</h3><div class="scaled-editor-preview__product-price"><span class="scaled-editor-preview__current-price{% if product.compare_at_price > product.price %} scaled-editor-preview__current-price--sale{% endif %}">{{ product.price | money }}</span>{%- if product.compare_at_price > product.price -%}<span class="scaled-editor-preview__compare-price">{{ product.compare_at_price | money }}</span>{%- endif -%}</div></div>{%- endif -%}{%- endfor -%}</div>
<p class="scaled-editor-preview__note">Preview only - full styling loads on live site</p>
{%- else -%}
<p class="scaled-editor-preview__note">Add product blocks to display products</p>
{%- endif -%}
</div>
<noscript><div class="scaled-shell__noscript"><p>Enable JavaScript to view products.</p></div></noscript>
</section>
<style>
#scaled-secondary-product-grid .scaled-editor-preview{text-align:center;padding:48px 16px}
#scaled-secondary-product-grid .scaled-editor-preview__headline{font-family:'Satoshi',-apple-system,BlinkMacSystemFont,sans-serif;font-size:clamp(1.75rem,5vw,2.5rem);font-weight:900;text-transform:uppercase;letter-spacing:-0.5px;line-height:1.1;color:var(--color-text,#fff);margin:0}
#scaled-secondary-product-grid .scaled-editor-preview__subheadline{font-size:16px;color:var(--color-text-muted,#9ca3af);margin:12px 0 0;max-width:600px;margin-left:auto;margin-right:auto}
#scaled-secondary-product-grid .scaled-editor-preview__note{margin-top:32px;color:var(--color-text-muted,#9ca3af);font-size:14px}
#scaled-secondary-product-grid .scaled-editor-preview__grid{display:grid;grid-template-columns:repeat(var(--products-per-row,4),1fr);gap:20px;max-width:1200px;margin:32px auto 0;padding:0 16px}
@media(max-width:900px){#scaled-secondary-product-grid .scaled-editor-preview__grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){#scaled-secondary-product-grid .scaled-editor-preview__grid{grid-template-columns:1fr}}
#scaled-secondary-product-grid .scaled-editor-preview__product{background:var(--color-card-bg,rgba(255,255,255,0.05));border-radius:12px;overflow:hidden;text-align:left}
#scaled-secondary-product-grid .scaled-editor-preview__product-image{position:relative;aspect-ratio:1;background:rgba(0,0,0,0.2)}
#scaled-secondary-product-grid .scaled-editor-preview__product-image img{width:100%;height:100%;object-fit:cover}
#scaled-secondary-product-grid .scaled-editor-preview__product-placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--color-text-muted,#9ca3af)}
#scaled-secondary-product-grid .scaled-editor-preview__badge{position:absolute;top:8px;right:8px;background:var(--color-accent,#ef4444);color:#fff;font-size:11px;font-weight:700;padding:4px 8px;border-radius:4px;text-transform:uppercase}
#scaled-secondary-product-grid .scaled-editor-preview__product-title{font-size:14px;font-weight:600;color:var(--color-text,#fff);margin:12px 12px 8px;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
#scaled-secondary-product-grid .scaled-editor-preview__product-price{padding:0 12px 12px;display:flex;align-items:center;gap:8px}
#scaled-secondary-product-grid .scaled-editor-preview__current-price{font-size:16px;font-weight:700;color:var(--color-text,#fff)}
#scaled-secondary-product-grid .scaled-editor-preview__current-price--sale{color:var(--color-accent,#ef4444)}
#scaled-secondary-product-grid .scaled-editor-preview__compare-price{font-size:14px;color:var(--color-text-muted,#9ca3af);text-decoration:line-through}
.scaled-shell:not(.scaled-shell--loading) .scaled-editor-preview{display:none}
</style>
<script type="application/json" data-scaled-section-settings="secondary-product-grid">
{"headline":{{ section.settings.headline | default: "More Products You'll Love" | json }},"highlight_word":{{ section.settings.highlight_word | default: "" | json }},"subheadline":{{ section.settings.subheadline | default: "" | json }},"products_per_row":{{ section.settings.products_per_row | default: 4 }},"primary_button_text":{{ section.settings.primary_button_text | default: "VIEW PRODUCT" | json }},"primary_button_action":{{ section.settings.primary_button_action | default: "product" | json }},"primary_button_custom_url":{{ section.settings.primary_button_custom_url | json }},"sale_badge_text":{{ section.settings.sale_badge_text | default: "SALE" | json }},"sale_badge_position":{{ section.settings.sale_badge_position | default: "top-right" | json }},"show_background_gradient":{{ section.settings.show_background_gradient | json }}}
</script>
<script type="application/json" data-scaled-products="secondary-product-grid">
[{%- assign product_count = 0 -%}{%- for block in section.blocks -%}{%- if block.type == 'product' and block.settings.product != blank -%}{%- assign product = block.settings.product -%}{%- if product.available -%}{%- if product_count > 0 -%},{%- endif -%}{"id":{{ product.id | json }},"variantId":{{ product.selected_or_first_available_variant.id | json }},"title":{{ product.title | json }},"handle":{{ product.handle | json }},"url":{{ product.url | json }},"price":{{ product.price }},"comparePrice":{{ product.compare_at_price | default: 'null' }},"available":{{ product.available | json }},"image":{% if product.featured_image %}{{ product.featured_image | image_url: width: 500 | json }}{% else %}null{% endif %},"imageAlt":{{ product.featured_image.alt | default: product.title | json }}}{%- assign product_count = product_count | plus: 1 -%}{%- endif -%}{%- endif -%}{%- endfor -%}]
</script>
{% schema %}
{"name":"Secondary Product Grid","tag":"section","class":"scaled-secondary-product-grid-wrapper","settings":[{"type":"header","content":"Header Settings"},{"type":"text","id":"headline","label":"Section Headline","default":"More Products You'll Love"},{"type":"text","id":"highlight_word","label":"Highlight Word","info":"Single word to highlight with accent color"},{"type":"textarea","id":"subheadline","label":"Section Subheadline"},{"type":"checkbox","id":"show_background_gradient","label":"Show Background Gradient","info":"Adds a subtle gradient glow using Accent Color 1","default":true},{"type":"header","content":"Product Grid Settings"},{"type":"range","id":"products_per_row","label":"Products Per Row (Desktop)","min":2,"max":4,"step":1,"default":4},{"type":"header","content":"Primary Button"},{"type":"text","id":"primary_button_text","label":"Primary Button Text","default":"VIEW PRODUCT"},{"type":"select","id":"primary_button_action","label":"Primary Button Action","options":[{"value":"product","label":"Go to Product Page"},{"value":"checkout","label":"Direct to Checkout"},{"value":"custom","label":"Custom Link"}],"default":"product"},{"type":"url","id":"primary_button_custom_url","label":"Primary Custom URL","info":"Only used when 'Custom Link' is selected"},{"type":"header","content":"Sale Badge"},{"type":"text","id":"sale_badge_text","label":"Sale Badge Text","default":"SALE"},{"type":"select","id":"sale_badge_position","label":"Sale Badge Position","options":[{"value":"top-left","label":"Top Left"},{"value":"top-right","label":"Top Right"},{"value":"bottom-left","label":"Bottom Left"},{"value":"bottom-right","label":"Bottom Right"}],"default":"top-right"}],"blocks":[{"type":"product","name":"Product","settings":[{"type":"product","id":"product","label":"Product"}]}],"presets":[{"name":"Secondary Product Grid"}]}
{% endschema %}
