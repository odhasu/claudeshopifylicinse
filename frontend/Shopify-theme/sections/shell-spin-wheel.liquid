{%- if section.settings.enabled and section.blocks.size > 0 -%}
<section id="scaled-spin-wheel" class="scaled-shell scaled-shell--spin-wheel" data-scaled-section="spin-wheel" aria-label="Spin to Win"></section>
<script type="application/json" data-scaled-section-settings="spin-wheel">
{"enabled":{{ section.settings.enabled | json }},"headline":{{ section.settings.headline | json }},"subheadline":{{ section.settings.subheadline | json }},"trigger_delay":{{ section.settings.trigger_delay | default: 5 }},"show_on_exit_intent":{{ section.settings.show_on_exit_intent | json }},"cookie_duration_days":{{ section.settings.cookie_duration_days | default: 7 }},"name_placeholder":{{ section.settings.name_placeholder | json }},"email_placeholder":{{ section.settings.email_placeholder | json }},"phone_placeholder":{{ section.settings.phone_placeholder | json }},"require_phone":{{ section.settings.require_phone | json }},"spin_button_text":{{ section.settings.spin_button_text | json }},"consent_text":{{ section.settings.consent_text | json }},"win_headline":{{ section.settings.win_headline | json }},"claim_button_text":{{ section.settings.claim_button_text | json }},"claim_button_url":{{ section.settings.claim_button_url | json }},"prizes":[{%- for block in section.blocks -%}{"text":{{ block.settings.prize_text | json }},"code":{{ block.settings.prize_code | json }},"color":{{ block.settings.prize_color | json }},"probability":{{ block.settings.probability | default: 5 }},"is_winner":{{ block.settings.is_winner | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}
</script>
{%- endif -%}
{% schema %}
{"name":"Spin to Win","tag":"section","class":"scaled-spin-wheel-wrapper","settings":[{"type":"checkbox","id":"enabled","label":"Enable Spin Wheel Popup","default":true},{"type":"header","content":"Popup Content"},{"type":"text","id":"headline","label":"Headline","default":"SPIN TO WIN!"},{"type":"textarea","id":"subheadline","label":"Subheadline","default":"Enter your details for a chance to win exclusive discounts!"},{"type":"header","content":"Trigger Settings"},{"type":"range","id":"trigger_delay","label":"Popup Delay (seconds)","min":1,"max":30,"step":1,"default":5,"info":"How long to wait before showing the popup"},{"type":"checkbox","id":"show_on_exit_intent","label":"Show on Exit Intent","default":false,"info":"Also show popup when user moves mouse to close the tab"},{"type":"range","id":"cookie_duration_days","label":"Days Before Reshowing","min":1,"max":30,"step":1,"default":7,"info":"Days to wait before showing to the same visitor again"},{"type":"header","content":"Form Fields"},{"type":"text","id":"name_placeholder","label":"Name Placeholder","default":"Your Name"},{"type":"text","id":"email_placeholder","label":"Email Placeholder","default":"Email Address"},{"type":"text","id":"phone_placeholder","label":"Phone Placeholder","default":"Phone Number"},{"type":"checkbox","id":"require_phone","label":"Require Phone Number","default":true},{"type":"text","id":"spin_button_text","label":"Spin Button Text","default":"SPIN THE WHEEL"},{"type":"header","content":"Winner Screen"},{"type":"text","id":"win_headline","label":"Win Headline","default":"CONGRATULATIONS!"},{"type":"text","id":"claim_button_text","label":"Claim Button Text","default":"CLAIM MY PRIZE"},{"type":"url","id":"claim_button_url","label":"Claim Button URL","info":"Where to redirect after claiming (leave blank to close popup)"}],"blocks":[{"type":"prize","name":"Prize Segment","settings":[{"type":"text","id":"prize_text","label":"Prize Text","default":"10% OFF"},{"type":"text","id":"prize_code","label":"Discount Code","info":"The code to display when won (optional)"},{"type":"color","id":"prize_color","label":"Segment Color","default":"#944aff"},{"type":"range","id":"probability","label":"Probability Weight","min":1,"max":100,"step":1,"default":50,"info":"Higher = more likely to land on this prize (1-100)"},{"type":"checkbox","id":"is_winner","label":"Is a Winning Prize","default":true,"info":"Uncheck for 'Try Again' or 'Spin Again' type prizes"}]}],"presets":[{"name":"Spin to Win","blocks":[{"type":"prize","settings":{"prize_text":"FREE VENDORS","prize_code":"FREELIST","prize_color":"#fbbf24","probability":5,"is_winner":true}},{"type":"prize","settings":{"prize_text":"20% OFF","prize_code":"SPIN20","prize_color":"#8b5cf6","probability":10,"is_winner":true}},{"type":"prize","settings":{"prize_text":"10% OFF","prize_code":"SPIN10","prize_color":"#ec4899","probability":20,"is_winner":true}},{"type":"prize","settings":{"prize_text":"5% OFF","prize_code":"SPIN5","prize_color":"#3b82f6","probability":30,"is_winner":true}},{"type":"prize","settings":{"prize_text":"SPIN AGAIN","prize_color":"#22c55e","probability":25,"is_winner":false}},{"type":"prize","settings":{"prize_text":"TRY AGAIN","prize_color":"#6b7280","probability":35,"is_winner":false}}]}]}
{% endschema %}
