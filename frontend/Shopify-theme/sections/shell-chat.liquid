
{%- if settings.chatbot_enabled -%}
<div
  id="scaled-chat"
  class="scaled-chat-shell"
  data-scaled-section="chat"
  aria-label="Chat Support"
>
  <button type="button" class="scaled-chat-local{% if section.settings.show_pulse %} scaled-chat-local--pulse{% endif %}" aria-label="Open chat">
    <span class="scaled-chat-local__title">{{ section.settings.assistant_name | default: 'Reselling Assistant' }}</span>
    <span class="scaled-chat-local__msg">{{ section.settings.greeting | default: "Hey! Got questions? I'm here to help you decide." }}</span>
  </button>
</div>

<style>
  .scaled-chat-local {
    max-width: min(320px, calc(100vw - 32px));
    text-align: left;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg-card);
    color: var(--color-text);
    box-shadow: 0 12px 26px rgba(0, 0, 0, 0.35);
    padding: 10px 12px;
  }
  .scaled-chat-local__title {
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 2px;
  }
  .scaled-chat-local__msg {
    display: block;
    font-size: 12px;
    color: var(--color-text-muted);
    line-height: 1.35;
  }
  .scaled-chat-local--pulse {
    animation: scaled-chat-pulse 2.2s ease-in-out infinite;
  }
  @keyframes scaled-chat-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.35), 0 12px 26px rgba(0, 0, 0, 0.35); }
    50% { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0), 0 12px 26px rgba(0, 0, 0, 0.35); }
  }
</style>

<script type="application/json" data-scaled-section-settings="chat">
{
  "name": {{ section.settings.assistant_name | default: "Reselling Assistant" | json }},
  "greeting": {{ section.settings.greeting | default: "Hey! Got questions? I'm here to help you decide." | json }},
  "position": {{ section.settings.position | default: "bottom-right" | json }},
  "showPulse": {{ section.settings.show_pulse | default: true | json }}
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "AI Reselling Assistant",
  "tag": "div",
  "class": "scaled-chat-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Chat Settings"
    },
    {
      "type": "text",
      "id": "assistant_name",
      "label": "Assistant Name",
      "default": "Reselling Assistant",
      "info": "Name shown in the chat header"
    },
    {
      "type": "text",
      "id": "greeting",
      "label": "Initial Greeting",
      "default": "Hey! Got questions? I'm here to help you decide.",
      "info": "First message shown when chat opens"
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Widget Position",
      "default": "bottom-right",
      "options": [
        { "value": "bottom-right", "label": "Bottom Right" },
        { "value": "bottom-left", "label": "Bottom Left" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_pulse",
      "label": "Show online indicator",
      "default": true,
      "info": "Green pulse animation to show the bot is active"
    }
  ],
  "presets": [
    {
      "name": "AI Sales Assistant"
    }
  ]
}
{% endschema %}
