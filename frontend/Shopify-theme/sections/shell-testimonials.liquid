  endif
  assign image_indices = image_list | split: ','
-%}

<section
  id="scaled-testimonials"
  class="scaled-testimonials-shell"
  data-scaled-section="testimonials"
  aria-label="Customer Testimonials"
>
  <div class="container scaled-testimonials-local" style="--tm-height: {{ section.settings.image_height | default: 250 }}px; --tm-max-width: {{ section.settings.max_width | default: 900 }}px;">
    <h2 class="scaled-testimonials-local__headline">{{ section.settings.headline | default: 'What Our Customers Say' }}</h2>
    <div class="scaled-testimonials-local__grid">
      {%- assign rendered_testimonials = 0 -%}
      {%- for index in image_indices -%}
        {%- if index != blank -%}
          {%- assign img_key = 'image_' | append: index -%}
          {%- assign current_image = section.settings[img_key] -%}
          {%- if current_image != blank and rendered_testimonials < 12 -%}
            <figure class="scaled-testimonials-local__item">
              {{ current_image | image_url: height: 500 | image_tag: alt: current_image.alt | default: 'Customer review', class: 'scaled-testimonials-local__image' }}
            </figure>
            {%- assign rendered_testimonials = rendered_testimonials | plus: 1 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if rendered_testimonials == 0 -%}
        <p class="scaled-testimonials-local__empty">Add testimonial images in the Theme Editor to display social proof.</p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .scaled-testimonials-local {
    padding: 40px 0;
    width: min(100%, var(--tm-max-width));
  }
  .scaled-testimonials-local__headline {
    margin: 0 0 14px;
    text-align: center;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }
  .scaled-testimonials-local__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .scaled-testimonials-local__item {
    margin: 0;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
  }
  .scaled-testimonials-local__image {
    width: 100%;
    height: var(--tm-height);
    object-fit: cover;
  }
  .scaled-testimonials-local__empty {
    grid-column: 1 / -1;
    text-align: center;
    margin: 0;
    color: var(--color-text-muted);
  }
  @media (min-width: 900px) {
    .scaled-testimonials-local__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script type="application/json" data-scaled-section-settings="testimonials">
{
  "headline": {{ section.settings.headline | default: "What Our Customers Say" | json }},
  "animationSpeed": {{ section.settings.animation_speed | default: 20 | json }},
  "maxWidth": {{ section.settings.max_width | default: 900 | json }},
  "imageHeight": {{ section.settings.image_height | default: 250 | json }},
  "images": [
    {%- for index in image_indices -%}
      {%- if index != blank -%}
        {%- assign img_key = 'image_' | append: index -%}
        {%- assign current_image = section.settings[img_key] -%}
        {%- if current_image != blank -%}
          {
            "url": {{ current_image | image_url: height: 500 | json }},
            "alt": {{ current_image.alt | default: '' | json }},
            "width": {{ current_image.width | json }},
            "height": {{ current_image.height | json }},
            "aspectRatio": {{ current_image.aspect_ratio | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>

{% schema %}
{
