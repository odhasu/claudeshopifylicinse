    assign image_list = image_list | append: '6,'
  endif
  if section.settings.image_7 != blank
    assign image_list = image_list | append: '7,'
  endif
  if section.settings.image_8 != blank
    assign image_list = image_list | append: '8,'
  endif
  if section.settings.image_9 != blank
