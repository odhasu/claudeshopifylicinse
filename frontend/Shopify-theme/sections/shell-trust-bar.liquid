{%- if section.settings.enable_bar -%}
<div id="scaled-trust-bar" class="scaled-trust-bar-shell" data-scaled-section="trust-bar" aria-label="Trust Indicators"></div>
<script type="application/json" data-scaled-section-settings="trust-bar">
{"barHeight":{{ section.settings.bar_height | default: 44 | json }},"animationSpeed":{{ section.settings.animation_speed | default: 30 | json }},"backgroundStyle":{{ section.settings.background_style | default: "transparent" | json }},"showSeparator":{{ section.settings.show_separator | default: true | json }},"badges":[{%- for block in section.blocks -%}{%- if block.type == 'badge' -%}{"text":{{ block.settings.text | json }},"iconType":{{ block.settings.icon_type | default: "none" | json }},"customIcon":{% if block.settings.custom_icon %}{{ block.settings.custom_icon | image_url: height: 40 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{%- endif -%}{%- endfor -%}]}
</script>
{%- endif -%}
{% schema %}
{"name":"Trust Bar","tag":"section","class":"scaled-trust-bar-wrapper","settings":[{"type":"checkbox","id":"enable_bar","label":"Enable Trust Bar","default":true},{"type":"header","content":"Appearance"},{"type":"range","id":"bar_height","label":"Bar Height","min":36,"max":60,"step":2,"default":44,"unit":"px"},{"type":"select","id":"background_style","label":"Background Style","options":[{"value":"transparent","label":"Transparent"},{"value":"solid","label":"Solid (Card Background)"},{"value":"gradient","label":"Subtle Gradient"}],"default":"transparent"},{"type":"checkbox","id":"show_separator","label":"Show dot separator between items","default":true},{"type":"header","content":"Animation"},{"type":"range","id":"animation_speed","label":"Scroll Speed","min":15,"max":60,"step":5,"default":30,"unit":"s","info":"Lower = faster scrolling"}],"blocks":[{"type":"badge","name":"Badge","settings":[{"type":"text","id":"text","label":"Badge Text","default":"Trusted by 5,000+"},{"type":"select","id":"icon_type","label":"Icon","options":[{"value":"none","label":"None"},{"value":"checkmark","label":"Checkmark"},{"value":"shield","label":"Shield (Verified)"},{"value":"star","label":"Star"},{"value":"bolt","label":"Bolt (Instant)"},{"value":"headset","label":"Headset (Support)"},{"value":"lock","label":"Lock (Secure)"},{"value":"users","label":"Users (Community)"},{"value":"custom","label":"Custom Image"}],"default":"checkmark"},{"type":"image_picker","id":"custom_icon","label":"Custom Icon Image","info":"Only used when Icon is set to 'Custom Image'"}]}],"presets":[{"name":"Trust Bar","blocks":[{"type":"badge","settings":{"text":"5,000+ Happy Customers","icon_type":"users"}},{"type":"badge","settings":{"text":"Verified Seller","icon_type":"shield"}},{"type":"badge","settings":{"text":"24/7 Support","icon_type":"headset"}},{"type":"badge","settings":{"text":"Instant Access","icon_type":"bolt"}}]}]}
{% endschema %}
